	)
	(text "J3 CONTROL (JST GH-5)\n1 GND\n2 SCL (+3v3, 10k pullup; charger 0x6A, gauge 0x70)\n3 SDA (+3v3, 10k pullup)\n4 BAT_ALM (out, STC3115 ALM, OD +3V3 pullup)\n5 CHG_INT (out, BQ25895 /INT, OD +3V3 pullup)\n"
		(exclude_from_sim no)
		(at 198.12 152.65 0)
