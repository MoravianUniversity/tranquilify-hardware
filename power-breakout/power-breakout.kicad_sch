	(text "HOST_3V3_EN: OD low while SYS present\n(floats when breakout unpowered)"
		(exclude_from_sim no)
		(at 49.276 144.272 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "11a5b115-7a9a-4d6a-8ad2-d0f21b4a44cc")
	)
	(text "C1–C7 close to U1\nR1 can be 330 or 390 ohm to limit charging closer to 1A (can also be done in firmware)\nFW:\n * clear MAXC_EN + HVDCP_EN (makes DSEL more reliable and we aren't using those features anyways)\n * ICHG to 1024 mA or similar (ILIM in circuit still sets the hard max)\n * VREG to 4.208 V (expected battery's charge voltage)\n * WATCHDOG to 0 (disable it, otherwise the host has to set WD_RST periodically)\n * Optionally: IINLIM, OTG_CONFIG=0, BATFET_DIS when shipping"
		(exclude_from_sim no)
		(at 121.412 98.298 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2d530b4a-fd4b-427a-93d1-24a13025c263")
	)
	(text "C11–C13 close to U4"
		(exclude_from_sim no)
		(at 260.35 92.202 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2fb24eed-aa2d-4927-9589-f21e68618d81")
	)
	(text "Battery Fuel Gauge"
		(exclude_from_sim no)
		(at 60.96 81.026 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "4d2cd970-38e5-47be-a8fb-d5552eec572c")
	)
	(text "STC3115AIQT (U3): I2C 0x38; ~3500 mAh; Rsense R9=10 mΩ low-side.\nC10 close to U3; BATD/CD and RSTIO are disabled.\nKelvin: CG→R9 PACK- pad; GND→R9 GND pad. FW: clear VMODE for mixed mode;\nCC_CNF≈Rsense_mΩ*Cnom_mAh/49.55 ≈707; program ALM SOC/voltage."
		(exclude_from_sim no)
		(at 14.986 124.206 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "506d56d1-9f92-4219-9e25-69c3331f10c2")
	)
	(text "U6 USB mux (DSEL):\n  DSEL low  → charger BC1.2 (HSD1)\n  DSEL high → host J2 (HSD2)\nFW: clear MAXC_EN + HVDCP_EN"
		(exclude_from_sim no)
		(at 87.122 79.248 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "759d87b1-c1db-40ee-896c-b851ef55dcc1")
	)
